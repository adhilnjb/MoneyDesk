# Copy to .env and edit. Never commit the real .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your https origin(s) in production, e.g. https://money.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Turn off once your own account exists so nobody else can register
ALLOW_SIGNUP=True
# Idle logout in seconds (sliding session)
SESSION_IDLE_SECONDS=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Change the admin address so it is not guessable
ADMIN_URL=admin/
